# ==============================================================================
# Agent System Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Core System Settings
# ------------------------------------------------------------------------------
AGENTS_WORKSPACE_DIR=/app/agents_workspace
AGENTS_BASE_URL=

# Comma-separated list of allowed CORS origins (default: localhost dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:8150

# ------------------------------------------------------------------------------
# LLM / Model Client Configuration
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gpt-oss:120b-cloud

# ------------------------------------------------------------------------------
# External Services & APIs
# ------------------------------------------------------------------------------
MONAI_URL=http://localhost:8000
CONTROL_API_URL=http://localhost:8001
ORTHANC_URL=http://localhost:8043
BACKEND_API_BASE=http://localhost:8000

# Control-plane requests fail quickly; long inference runs as a durable job.
CONTROL_CONNECT_SECONDS=3
CONTROL_READ_SECONDS=8
BEST_EFFORT_TIMEOUT_SECONDS=10
SEGMENTATION_JOB_TIMEOUT_SECONDS=1800
SEGMENTATION_POLL_SECONDS=3
SEGMENTATION_UNAVAILABLE_GRACE_SECONDS=600
LONG_TOOL_TIMEOUT_SECONDS=2100
TOOL_HEARTBEAT_SECONDS=30
CANCELLATION_GRACE_SECONDS=10
FEATURE_EXTRACTION_TIMEOUT_SECONDS=600
LLM_RETRY_DELAYS_SECONDS=1,4,16
MCP_STANDARD_READ_SECONDS=2000
MCP_COMPUTE_READ_SECONDS=3600

# Multi-Agent System (MAS) endpoints for socket/messaging
MAS_BASE_URL=http://localhost:8150
MAS_WS_URL=ws://localhost:8150/ws

# NCBI API Key (for literature review agent)
NCBI_API_KEY=

# ------------------------------------------------------------------------------
# Benchmarking & Evaluation (Optional)
# ------------------------------------------------------------------------------
JUDGE_MODEL=qwen2.5-coder:7b
JUDGE_BASE_URL=http://localhost:11434
JUDGE_API_KEY=ollama
JUDGE_TIMEOUT=180
JUDGE_FALLBACK_MODELS=
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=
JUDGE_USE_AUTOGEN=true
QWEN_API_KEY=
MODEL_NAME=
