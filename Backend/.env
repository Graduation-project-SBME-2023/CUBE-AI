# Backend/.env

# Absolute path to the project root (the folder containing Backend/ and Frontend/).
# Docker Compose uses this to resolve all volume mount paths.


COMPOSE_PROJECT_DIR=..
BACKEND_STORAGE_ROOT=./storage

# PostgreSQL container setup
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=password
POSTGRES_DB=workflow_db

# Database URL used by Python backend and Alembic
DATABASE_URL=postgresql+asyncpg://workflow_user:password@postgres:5432/workflow_db

# Orthanc Server connection details
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc
CORS_ORIGINS=http://localhost:3000,http://localhost:8150,http://localhost,http://127.0.0.1
