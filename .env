# ==========================================================
# Core LLM client configuration
# ==========================================================
# Required for current runtime setup (used by app.py and client_config.py)
OLLAMA_API_KEY=

# Optional: choose provider/model defaults in the client config UI/API
# Supported providers: openai | azure_openai | ollama
LLM_PROVIDER=ollama
LLM_MODEL=deepseek-v3.1:671b-cloud
LLM_BASE_URL=

# Optional OpenAI-compatible settings
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional Azure OpenAI settings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=


# ==========================================================
# Literature review / medical APIs
# ==========================================================
# Optional but strongly recommended to avoid NCBI throttling.
NCBI_API_KEY=64818b825f3bab12f15d70518984d0f19c08


# ==========================================================
# Optional model routing used in benchmarks/utilities
# ==========================================================
QWEN_API_KEY=
JUDGE_MODEL=llama3.1:8b
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=
JUDGE_TIMEOUT=180


# ==========================================================
# Optional legacy key used by segmentation_module.py
# ==========================================================
APIKEY=
