# Base image: Python 3.13, patch release pinned (Debian 13, trixie)
FROM python:3.13.16-slim

# Install system dependencies:
# - texlive-full for pdflatex support
# - build tools (gcc, g++, cmake) for compiling PyRadiomics C extensions
# - git for installing PyRadiomics from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    gcc \
    g++ \
    cmake \
    make \
    git \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for layer caching
COPY ./Backend/agent_system/requirements.txt .

# Step 1: Install dependencies from requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Step 2: Install PyRadiomics from source (builds C extensions), pinned to the
# tested commit rather than whatever master is
RUN pip install --no-cache-dir git+https://github.com/AIM-Harvard/pyradiomics.git@8ed5793

# Copy application source
COPY ./Backend/agent_system ./Backend/agent_system
COPY ./Backend/storage_paths.py ./Backend/storage_paths.py
COPY ./Backend/storage_write_guard.py ./Backend/storage_write_guard.py

ENV BACKEND_STORAGE_ROOT=/storage \
    AGENTS_WORKSPACE_DIR=/storage/hypotheses \
    BACKEND_TEMP_DIR=/storage/temp \
    BACKEND_LOG_DIR=/storage/logs \
    HF_HOME=/storage/cache/huggingface \
    PYTHONPATH=/app/Backend

# The Claude Code CLI that claude-agent-sdk bundles (Phase 9.1): no telemetry,
# update checks or other traffic beyond the model calls.
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Default command
CMD ["python", "./Backend/agent_system/app.py"]
