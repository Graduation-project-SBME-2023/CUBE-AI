# Base image with Python 3.11.3
FROM python:3.11.3-slim

# Install system dependencies:
# - texlive-full for pdflatex support
# - build tools (gcc, g++, cmake) for compiling PyRadiomics C extensions
# - git for installing PyRadiomics from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    gcc \
    g++ \
    cmake \
    make \
    git \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for layer caching
COPY ./Backend/agent_system/requirements.txt .

# Step 1: Install dependencies from requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Step 2: Install PyRadiomics from source (builds C extensions)
RUN pip install --no-cache-dir git+https://github.com/AIM-Harvard/pyradiomics.git

# Step 3: Install pinned numeric libraries LAST (must not be overwritten)
RUN pip install --no-cache-dir numpy==1.26.4 pandas==2.1.4 pycaret==3.3.2 shap

# Copy application source
COPY ./Backend/agent_system ./Backend/agent_system
COPY ./Backend/mcp ./Backend/mcp
COPY ./Backend/storage_paths.py ./Backend/storage_paths.py

ENV BACKEND_STORAGE_ROOT=/storage \
    AGENTS_WORKSPACE_DIR=/storage/hypotheses \
    BACKEND_TEMP_DIR=/storage/temp \
    BACKEND_LOG_DIR=/storage/logs \
    HF_HOME=/storage/cache/huggingface \
    PIPELINE_MAX_CONCURRENCY=1 \
    PIPELINE_QUEUE_CAPACITY=8 \
    PLANNING_MAX_CONCURRENCY=2 \
    PLANNING_QUEUE_CAPACITY=16 \
    WS_INPUT_QUEUE_SIZE=32 \
    WS_OUTBOUND_QUEUE_SIZE=256 \
    WS_CLIENT_MESSAGE_HISTORY=1024 \
    WS_MAX_CONNECTIONS=256 \
    WS_MAX_CONNECTIONS_PER_SESSION=8 \
    WS_MAX_MESSAGE_BYTES=65536 \
    WS_SESSION_IDLE_TTL_SECONDS=3600 \
    PYTHONPATH=/app/Backend

# Default command
CMD ["python", "./Backend/agent_system/app.py"]
