# ============================================================
# CUBE.AI — custom-monailabel  (CPU / ARM64 variant)
# No CUDA toolkit — safe to build natively on arm64 (Apple
# Silicon) and amd64 without GPU drivers.
# ============================================================
FROM projectmonai/monailabel:0.8.5

# ------------------------------------------------------------
# 1. System packages
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 2. Python dependencies (all baked in, nothing at runtime)
# ------------------------------------------------------------
RUN pip install --no-cache-dir -U pip && \
    pip install --no-cache-dir \
        batchgenerators \
        acvl-utils \
        asyncpg \
        nnunetv2 \
        nnInteractive \
        "pydicom==2.4.4" \
        psycopg2-binary \
        aiohttp \
        alembic

COPY ./requirements/voxtell.txt /voxtell_requirements.txt
RUN pip install --no-cache-dir -r /voxtell_requirements.txt

# ------------------------------------------------------------
# 3. Patched pydicom-seg sources
# ------------------------------------------------------------
COPY ./overrides/pydicom_seg/reader.py \
     /usr/local/lib/python3.10/dist-packages/pydicom_seg/reader.py
COPY ./overrides/pydicom_seg/segmentation_dataset.py \
     /usr/local/lib/python3.10/dist-packages/pydicom_seg/segmentation_dataset.py
COPY ./storage_paths.py /apps/radiology/storage_paths.py

# ------------------------------------------------------------
# 4. Environment variables
# ------------------------------------------------------------
ENV BACKEND_STORAGE_ROOT=/storage \
    AGENTS_WORKSPACE_DIR=/storage/hypotheses \
    GENERAL_DATA_DIR=/storage/data/medical \
    NNUNET_DIR=/storage/data/nnunet \
    nnUnet_folders=/storage/data/nnunet \
    MODELS_DIR=/storage/models \
    INFERENCE_JOB_DIR=/storage/jobs/inference \
    HF_HOME=/storage/cache/huggingface \
    BACKEND_TEMP_DIR=/storage/temp \
    BACKEND_LOG_DIR=/storage/logs \
    TMPDIR=/storage/temp/radiology \
    nnUNet_preprocessed=/storage/data/nnunet/nnUNet_preprocessed \
    nnUNet_results=/storage/data/nnunet/nnUNet_results \
    nnUNet_raw=/storage/data/nnunet/nnUNet_raw \
    DATABASE_URL=postgresql://workflow_user:password@postgres:5432/workflow_db \
    PYTHONPATH=/apps/radiology \
    PATH=/apps/radiology/bin:${PATH}
# ------------------------------------------------------------
# 5. Expose & default command
# ------------------------------------------------------------
EXPOSE 8000

CMD ["sh", "-c", "alembic -c /alembic/alembic.ini upgrade head && python /apps/radiology/voxtell_cache_builder.py && python /monailabel/server_start.py"]
