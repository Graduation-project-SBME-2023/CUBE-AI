FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    APP_API_PORT=8001 \
    APP_API_WORKERS=2

WORKDIR /app

RUN pip install --no-cache-dir \
    alembic \
    aiohttp \
    asyncpg \
    fastapi \
    httpx \
    imageio \
    numpy \
    pillow \
    psycopg2-binary \
    "pydicom==2.4.4" \
    pydantic-settings \
    python-multipart \
    sqlalchemy \
    "uvicorn[standard]"

COPY Backend/application_api /app/application_api
# V1 build step G: the artifact catalogue resolves `render_path` through
# storage_paths (the A13 GIF exception), so the Application API needs the
# same canonical path resolver every other service uses. It reads the render
# root through the /storage mount it already has and gains no other file
# ownership.
COPY Backend/storage_paths.py /app/storage_paths.py
COPY Backend/apps/radiology/lib/configs /app/apps/radiology/lib/configs

EXPOSE 8001

CMD ["python", "-m", "application_api.start"]
