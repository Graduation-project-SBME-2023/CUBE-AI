FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    APP_API_PORT=8001 \
    APP_API_WORKERS=2

WORKDIR /app

RUN pip install --no-cache-dir \
    alembic \
    aiohttp \
    asyncpg \
    fastapi \
    httpx \
    imageio \
    numpy \
    pillow \
    psycopg2-binary \
    "pydicom==2.4.4" \
    pydantic-settings \
    sqlalchemy \
    "uvicorn[standard]"

COPY Backend/application_api /app/application_api
COPY Backend/apps/radiology/lib/configs /app/apps/radiology/lib/configs

EXPOSE 8001

CMD ["python", "-m", "application_api.start"]
