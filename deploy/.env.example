# deploy/.env

# Project root relative to deploy/ (launchers override this with an absolute path).
# Docker Compose uses it to resolve all volume mount paths.
COMPOSE_PROJECT_DIR=..
BACKEND_STORAGE_ROOT=./storage

# PostgreSQL container setup
# Pick your own values — do not reuse these placeholders for anything real.
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflow_db

# Database URL used by Python backend and Alembic — must match the
# credentials above.
DATABASE_URL=postgresql+asyncpg://workflow_user:change-me@postgres:5432/workflow_db

# Orthanc Server connection details
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=change-me
# Shared secret the Orthanc Lua webhook must present when it calls
# POST /sync/orthanc-webhook. Set the SAME value in
# Backend/orthanc/lua/on-stable-series.lua's WEBHOOK_TOKEN. Leave unset to
# disable the check (only acceptable when that endpoint is not reachable
# from outside the docker-compose network).
ORTHANC_WEBHOOK_TOKEN=
# Shared secret internal producers -- MCP tool subprocesses, all posting
# through Backend/mcp/internal_emitter.py -- must present to POST /events and
# /ws-broadcast on the Agent System. In-process agent-system code (the
# segmentation module, the view emitter) no longer goes through either route
# at all: it calls socket_store.manager directly (WEBSOCKET_FIX_PLAN.md WS-06).
# Unlike ORTHANC_WEBHOOK_TOKEN above, this check is FAIL-CLOSED: the Agent
# System refuses to start if this is unset, unless
# WS_INTERNAL_TOKEN_DEV_BYPASS=1 is also set. /ws-broadcast can write durable
# agent status (agent_waiting_for_user_input), so leaving this open is a
# standing vulnerability, not a convenience -- see WEBSOCKET_FIX_PLAN.md W12.
WS_INTERNAL_TOKEN=
# Explicit opt-out for local development only. Never set this in a deployed
# environment.
WS_INTERNAL_TOKEN_DEV_BYPASS=
CORS_ORIGINS=http://localhost:3000,http://localhost:8150,http://localhost,http://127.0.0.1

# ------------------------------------------------------------------------------
# Core System Settings (Optional tuning for Agent System)
# ------------------------------------------------------------------------------
AGENTS_WORKSPACE_DIR=./storage/hypotheses
GENERAL_DATA_DIR=./storage/data/medical
NNUNET_DIR=./storage/data/nnunet
nnUnet_folders=./storage/data/nnunet
MODELS_DIR=./storage/models
INFERENCE_JOB_DIR=./storage/jobs/inference
HF_HOME=./storage/cache/huggingface
BACKEND_TEMP_DIR=./storage/temp
BACKEND_LOG_DIR=./storage/logs
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gpt-oss:120b-cloud

CONTROL_CONNECT_SECONDS=3
CONTROL_READ_SECONDS=8
BEST_EFFORT_TIMEOUT_SECONDS=10
SEGMENTATION_JOB_TIMEOUT_SECONDS=1800
SEGMENTATION_POLL_SECONDS=3
SEGMENTATION_UNAVAILABLE_GRACE_SECONDS=600
LONG_TOOL_TIMEOUT_SECONDS=2100
TOOL_HEARTBEAT_SECONDS=30
CANCELLATION_GRACE_SECONDS=10
FEATURE_EXTRACTION_TIMEOUT_SECONDS=600
LLM_RETRY_DELAYS_SECONDS=1,4,16
MCP_STANDARD_READ_SECONDS=2000
MCP_COMPUTE_READ_SECONDS=3600

# Per-connection outbound WebSocket send timeout, and the bounded queue depth
# a stalled connection may back up to before it is evicted (closed, not
# throttled -- the client reconnects and catches up from the durable log via
# the handshake's after_event_id cursor). See WEBSOCKET_FIX_PLAN.md WS-04.
WS_SEND_TIMEOUT_SECONDS=3
WS_OUTBOUND_QUEUE_MAXSIZE=200
# Timeout for an MCP tool subprocess's best-effort POST to /events or
# /ws-broadcast (Backend/mcp/internal_emitter.py). The domain write it
# follows has already committed, so a slow or failed POST only costs a live
# UI update, never correctness -- see WEBSOCKET_FIX_PLAN.md WS-07.
INTERNAL_EMIT_TIMEOUT_SECONDS=5
