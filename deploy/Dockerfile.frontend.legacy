# Stage 1: Build OHIF Viewer
FROM node:20-slim AS builder

WORKDIR /usr/src/app

COPY OHIF-Viewer /usr/src/app

RUN apt-get update && apt-get install -y build-essential python3 git
RUN yarn config set workspaces-experimental true
RUN yarn install --ignore-engines

ENV APP_CONFIG=config/docker_openresty-orthanc.js
ENV QUICK_BUILD=true
ENV PATH=/usr/src/app/node_modules/.bin:$PATH

RUN yarn run build


# Stage 2: Serve using OpenResty
FROM openresty/openresty:1.31.1.1-2-alpine-fat

# Expose ports
EXPOSE 80 443

# Install system dependencies
RUN apk add --no-cache openssl openssl-dev git gcc curl unzip

# Install Lua modules
RUN luarocks install lua-resty-openidc && \
    luarocks install lua-resty-jwt && \
    luarocks install lua-resty-session && \
    luarocks install lua-resty-http

# Create log directory
RUN mkdir -p /var/log/nginx

# Copy nginx config
COPY ./nginx.conf /usr/local/openresty/nginx/conf/nginx.conf

# Copy built frontend app
COPY --from=builder /usr/src/app/platform/app/dist /var/www/html

# Start OpenResty (nginx)
ENTRYPOINT ["/usr/local/openresty/nginx/sbin/nginx", "-g", "daemon off;"]
